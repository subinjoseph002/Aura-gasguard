# =====================================================================================
# Aura GasGuard - Git Ignore Rules
# =====================================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
ENV/
env/
venv/
.venv/
ENV/

# Environment variables & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets.ini

# SQLite Database Files (Preserve data directory via .gitkeep, ignore runtime DB files)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# PlatformIO & Embedded Build Artifacts
.pio/
.pioenvs/
.piolibdeps/
compile_commands.json

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Drivers & Archives
drivers/*.zip

# Local Wi-Fi credentials
include/secrets.h
