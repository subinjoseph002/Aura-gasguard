# =====================================================================================
# Aura GasGuard™ - Environment Variables Example
# =====================================================================================

# Server Port
# On Render, this is automatically provided by the platform.
# For local Docker / native execution, defaults to 5000.
PORT=5000

# SQLite Database Persistence Path
# Local Docker Compose mount: /app/data/sensor_database.db
# Render Persistent Disk mount: /var/data/sensor_database.db
# Local native Python (optional): ./backend/data/sensor_database.db
DATABASE_PATH=/app/data/sensor_database.db

# Python runtime configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1


# Days of sensor readings kept before automatic pruning (default 3; ~5 readings/s)
RETENTION_DAYS=3

# --- Host-side serial_bridge.py (not used by the backend container) ---
# Force a serial port instead of auto-detecting the ESP32 (e.g. COM5 or /dev/ttyUSB0)
# SERIAL_PORT=COM5
# Where the bridge posts readings (defaults to the Render deployment)
# BACKEND_URL=http://localhost:5000/api/sensor-data
