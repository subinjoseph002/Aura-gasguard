# =====================================================================================
# Aura GasGuard™ - Environment Variables Example
# =====================================================================================

# Server Port
# On Render, this is automatically provided by the platform.
# For local Docker / native execution, defaults to 5000.
PORT=5000

# SQLite Database Persistence Path
# Local Docker Compose mount: /app/data/sensor_database.db
# Render Persistent Disk mount: /var/data/sensor_database.db
# Local native Python (optional): ./backend/data/sensor_database.db
DATABASE_PATH=/app/data/sensor_database.db

# Python runtime configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
